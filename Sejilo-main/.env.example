POSTGRES_DB=sejilo
POSTGRES_USER=sejilo
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
REDIS_PASSWORD=replace-with-a-different-long-random-development-password
# JWT signing secret used by the backend (required). Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-a-separate-long-random-monitoring-token
SEJILO_API_PORT=8080
LOG_LEVEL=info
MAX_CIPHERTEXT_BYTES=196608
MAX_QUEUED_MESSAGES_PER_DEVICE=2000
MAX_QUEUED_BYTES_PER_DEVICE=268435456
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
MAX_DEVICE_REQUESTS_PER_MINUTE=300
MAX_MESSAGES_PER_MINUTE=60
MAX_SOCKETS_PER_DEVICE=4
USER_SESSION_TTL_SECONDS=2592000
# Resend transactional email. The URL is the public reset screen served by the client.
RESEND_API_KEY=re_replace_with_a_resend_api_key
PASSWORD_RESET_FROM=SejiloChat <support@example.com>
PASSWORD_RESET_URL=https://chat.example.com/reset-password
WEB_ALLOWED_ORIGIN=https://chat.example.com

# --- Public exposure / edge (Cloudflare Tunnel) ---
# Browser origins allowed to call the API, comma-separated; `*` matches one
# hostname label. Empty or "*" in production refuses browser origins outright.
CORS_ORIGIN=https://*.trycloudflare.com
# Believe CF-Connecting-IP / X-Forwarded-For — only true behind a trusted proxy.
TRUST_PROXY=true
# Publish the OpenAPI browser at /api/docs. Keep false on a public URL.
ENABLE_SWAGGER=false

# --- Optional backend services (leave empty to disable) ---

# Google sign-in. The audience every Google credential is verified against; copy
# the project's value from backend/.env.example rather than inventing one, or the
# endpoint answers 503 and the app's compiled serverClientId will not match.
# There is deliberately no GOOGLE_CLIENT_SECRET: the client obtains the ID token
# and this server only verifies it, so no authorization-code exchange happens and
# nothing under backend/src reads a secret. See docs/GOOGLE_SIGNIN.md.
GOOGLE_CLIENT_ID=

# S3-compatible object storage (MinIO for local dev)
# Presigned upload URLs are generated only when S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are set.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=sejilo-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# SMS OTP delivery (Twilio). Without a provider, codes are logged in dev mode.
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Firebase Cloud Messaging (from a service-account JSON; escape private_key newlines as \n)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
