# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated platform scaffolding for the vendored flutter_bluetooth_plugin.
# The app's own windows/.gitignore and android/.gitignore already cover these
# for the top-level project, but packages/ has no .gitignore of its own, so 83
# generated files were committed — including a 264 MB flutter_windows.dll.pdb
# that is over GitHub's 100 MB per-file ceiling and made the repository
# unpushable. `flutter pub get` and the desktop builds recreate all of it.
**/flutter/ephemeral/
**/Flutter/ephemeral/
**/.gradle/
packages/**/build/
