# ─────────────────────────────────────────────────────────────────
# SejiloChat Backend — Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored.
#
# Generate strong secrets locally with:
#   JWT_SECRET=$(openssl rand -base64 48)
#   TOKEN_PEPPER=$(openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
PORT=8080

# ── Public exposure / edge ──
# Browser origins allowed to call the API, comma-separated. `*` in a hostname
# matches one label, so https://*.trycloudflare.com covers a rotating quick
# tunnel. Empty or "*" while NODE_ENV=production fails closed: browser origins
# are refused (native mobile clients send no Origin and are unaffected).
CORS_ORIGIN=

# Believe CF-Connecting-IP / X-Forwarded-For. Enable ONLY behind a trusted proxy
# such as Cloudflare Tunnel — without it every proxied request shares one
# rate-limit bucket; with it on a directly-reachable port, clients can forge
# their IP and evade rate limits entirely.
TRUST_PROXY=false

# Publish the OpenAPI browser at /api/docs and /docs.
# Unset = enabled outside production, disabled in production.
ENABLE_SWAGGER=

# ── PostgreSQL (REQUIRED) ──
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
# Hosted free (see docs/FREE_HOSTING.md): Supabase's SESSION POOLER string, on
# port 5432. The direct `db.<ref>.supabase.co` host is IPv6-only on new projects
# and a free Render instance cannot route to it, while the transaction pooler on
# port 6543 has no session-level advisory lock and so breaks
# `prisma migrate deploy`:
#   postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://sejilo:CHANGE_ME@localhost:5432/sejilo

# ── Redis (REQUIRED) ──
# Format: redis://:<password>@<host>:<port>/<db>
# Hosted free: Upstash's TCP string, NOT its REST URL. The rediss:// scheme is what
# turns on TLS in ioredis; a plain redis:// URL against Upstash just hangs —
#   rediss://default:pw@xxx.upstash.io:6379
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ── JWT signing (REQUIRED) ──
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSSL_RAND_BASE64_48
JWT_EXPIRES_IN=7d

# ── Google OAuth 2.0 (optional) ──
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID is the audience every Google credential is checked against.
# While it is empty, POST /v1/auth/google answers 503 — the endpoint cannot tell
# a token minted for this app from one minted for any other, so it refuses to
# guess. Email, phone and mesh sign-in are unaffected.
# It may hold a comma-separated list when a second platform client (native
# Android/desktop) also issues tokens for this backend.
# The Flutter client passes the same value as `serverClientId`, so they must
# match: see sejilo_chat/lib/auth/account_auth_controller.dart.
#
# The value below is this project's real Web client id, not a placeholder. An
# OAuth client id is public — it already ships inside the Android APK — so there
# is nothing to withhold here.
#
# There is deliberately no GOOGLE_CLIENT_SECRET. The app obtains the ID token and
# this server only verifies its signature and audience; no authorization-code
# exchange happens, so a secret would be a credential kept for nothing. If one
# has been pasted into a chat or a shell history, rotate it in the Google console.
GOOGLE_CLIENT_ID=705514627764-35tgptukli3i4qg2kvrrtkarc8k0f4od.apps.googleusercontent.com

# ── Cloudinary media storage (RECOMMENDED) ──
# Use either CLOUDINARY_URL or the three values below. Keep these server-side;
# never put the API secret in Flutter or commit it to source control.
# This is the recommended storage provider for production.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMS OTP delivery (optional) ──
# Without a provider, OTP codes are logged to the server console (dev mode).
# Twilio example:
#   SMS_PROVIDER=twilio
#   SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   SMS_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   SMS_FROM_NUMBER=+1234567890
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ── Firebase Cloud Messaging (optional) ──
# From a Firebase service account JSON:
#   FCM_PROJECT_ID      = project_id
#   FCM_CLIENT_EMAIL    = client_email
#   FCM_PRIVATE_KEY     = private_key  (escape newlines as \n)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Transactional email (optional; Resend) ──
RESEND_API_KEY=
PASSWORD_RESET_FROM=SejiloChat <noreply@example.com>
PASSWORD_RESET_URL=https://chat.example.com/reset-password

# ── Security ──
# Generate: openssl rand -base64 32
TOKEN_PEPPER=CHANGE_ME_GENERATE_WITH_OPENSSSL_RAND_BASE64_32
WEB_ALLOWED_ORIGIN=http://localhost:3000

# ── n8n outbound webhooks (optional) ──
# Set to true only after activating the corresponding n8n workflows. The URLs
# below are test endpoints; override them with your production webhook URLs.
WEBHOOKS_ENABLED=true
WEBHOOK_SECRET=
WEBHOOK_CHAT_URL=https://sejilochat.app.n8n.cloud/webhook-test/chat
WEBHOOK_ANALYTICS_URL=https://sejilochat.app.n8n.cloud/webhook-test/analytics
WEBHOOK_NOTIFICATIONS_URL=https://sejilochat.app.n8n.cloud/webhook-test/notifications
WEBHOOK_MEDIA_URL=https://sejilochat.app.n8n.cloud/webhook-test/media
WEBHOOK_SOCIAL_URL=https://sejilochat.app.n8n.cloud/webhook-test/social
WEBHOOK_POSTS_URL=https://sejilochat.app.n8n.cloud/webhook-test/posts
WEBHOOK_BT_SYNC_URL=https://sejilochat.app.n8n.cloud/webhook-test/bt-sync
WEBHOOK_AUTH_URL=https://sejilochat.app.n8n.cloud/webhook-test/auth
